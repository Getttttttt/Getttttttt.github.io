---
layout: default
---
{% assign research = site.data.research | where: 'slug', page.research_id | first %}
<article class="project-detail" id="main-content">
  <a class="back-link" href="{{ '/projects/' | relative_url }}">← All research projects</a>
  <span class="eyebrow">
    {{- research.venue }}
    {{ research.year -}}
    {%- if research.status == 'Forthcoming' %} · Forthcoming{% endif -%}
  </span>
  <h1 class="project-heading">{{ research.title }}</h1>
  <p class="project-deck">{{ research.summary }}</p>
  <div class="project-resources">
    {% if research.pdf -%}
      <a class="small-link primary" href="{{ research.pdf | relative_url }}" target="_blank" rel="noopener"
        >Read PDF <span aria-hidden="true">↗</span></a
      >
    {%- endif %}
    {% unless research.doi_unverified -%}
      <a class="small-link" href="{{ research.source_url }}" target="_blank" rel="noopener">Publisher <span aria-hidden="true">↗</span></a>
    {%- endunless %}
    <a class="small-link" href="{{ '/publications/' | relative_url }}#{{ research.key }}">Citation</a>
    {% if research.award -%}
      <a class="small-link" href="{{ research.award_url }}">Best Paper Award</a>
    {%- endif %}
  </div>
  <div class="project-description">
    <p>{{ research.description }}</p>
    {% if research.limitation %}
      <p class="limitation">{{ research.limitation }}</p>
    {% endif -%}
    {%- if research.note %}
      <p class="publication-note">{{ research.note }}</p>
    {% endif %}
  </div>
  <div class="figure-gallery">
    {% for figure in research.figures %}
      <figure class="paper-figure">
        <a
          class="figure-frame"
          href="{{ figure.src | relative_url }}"
          target="_blank"
          rel="noopener"
          style="display:block"
          aria-label="Open full-size {{ figure.number }}"
          ><img src="{{ figure.src | relative_url }}" alt="{{ figure.caption | escape }}" loading="lazy"
        ></a>
        <figcaption>
          <strong>{{ figure.number }}.</strong> {{ figure.caption -}}
          <br>
          From {{ research.attribution }}
          <a href="{% if research.pdf %}{{ research.pdf | relative_url }}{% else %}{{ research.source_url }}{% endif %}">Original paper</a>.
          {%- if research.license %}
            <a href="{{ research.license_url }}">{{ research.license }}</a>.
          {%- endif %}
        </figcaption>
      </figure>
    {% endfor %}
  </div>
  <div class="project-citation">
    <strong>{{ research.full_title }}</strong><br>
    {{ research.authors_readable }}.<br>
    {{ research.venue_full }} ({{ research.year }}).{% if research.status == 'Forthcoming' %} Forthcoming.{% endif %}
  </div>
</article>
