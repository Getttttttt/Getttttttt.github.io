---
---
<article class="publication" id="{{ entry.key }}" data-publication data-category="{{ entry.topic }}">
  <a class="publication-figure" href="{{ entry.project_url | relative_url }}" aria-label="Research details for {{ entry.title | escape }}"
    ><img
      src="{{ entry.preview | relative_url }}"
      alt="Research figure from {{ entry.abbr | escape }} {{ entry.year }}"
      width="360"
      height="240"
      loading="lazy"
  ></a>
  <div class="publication-content">
    <div class="publication-meta">
      <span class="venue-tag">
        {{- entry.abbr }}
        {{ entry.year -}}
      </span>
      {%- if entry.status == 'Forthcoming' -%}
        <span class="status-label">Forthcoming</span>
      {%- endif -%}
      {%- if entry.award -%}
        <a href="{{ entry.award_url }}">Best Paper Award</a>
      {%- endif %}
    </div>
    <h3>
      <a href="{{ entry.project_url | relative_url }}">{{ entry.title }}</a>
    </h3>
    <div class="authors">
      {% for author in entry.author_array -%}
        {%- if author.last == 'Gao' and author.first == 'Entong' -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{- author.first }}
          {{ author.last -}}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </div>
    <div class="journal">
      {% if entry.type == 'inproceedings' -%}
        {{- entry.booktitle -}}
      {%- else -%}
        {{- entry.journal -}}
        {%- if entry.volume %}, {{ entry.volume }}{% endif -%}
        {%- if entry.number %}({{ entry.number }}){% endif -%}
      {%- endif -%}
      {%- if entry.pages %}, {{ entry.pages | replace: '--', '–' }}{% endif %}.
    </div>
    {% if entry.additional_info %}
      <div class="publication-note">{{ entry.additional_info }}</div>
    {% endif %}
    <div class="publication-links">
      {% if entry.pdf -%}
        <a class="small-link primary" href="{{ entry.pdf | relative_url }}" target="_blank" rel="noopener">PDF <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.doi and entry.doi_unverified != 'true' -%}
        <a class="small-link" href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">DOI <span aria-hidden="true">↗</span></a>
      {%- endif %}
      <a class="small-link" href="{{ entry.project_url | relative_url }}">Research &amp; figures</a>
      {% if entry.license -%}
        <a class="small-link" href="{{ entry.license_url }}">{{ entry.license }}</a>
      {%- endif %}
    </div>
    <details class="citation-details">
      <summary>BibTeX</summary>
      <div class="citation-body">
        <button class="copy-citation" type="button">Copy citation</button>
        <pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
      </div>
    </details>
  </div>
</article>
